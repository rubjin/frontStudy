// Prisma 스키마 — DB 테이블의 '설계도' (Step 8-1)
//
// 여기 적은 model 하나가 DB의 테이블 하나가 된다. 필드 = 열(column).
// 이 파일을 고친 뒤 npm run db:migrate 를 실행하면
//   ① 바뀐 내용을 SQL로 만든 마이그레이션 파일(prisma/migrations/...)이 생기고 ② DB에 적용되고
//   ③ 타입이 붙은 DB 클라이언트(src/generated/prisma)가 다시 만들어진다.
//
// TypeScript의 interface Product(types/product.ts)와 비슷해 보이지만,
// 이쪽은 '데이터가 어떻게 저장되는지'(열 이름·타입·기본값·색인)를, 저쪽은 '화면이 어떤 모양을 쓰는지'를 정한다.
// 둘을 이어 주는 변환은 lib/products.ts의 toProduct()가 한다.

// 생성기: 이 스키마로 TypeScript DB 클라이언트를 만든다
// - prisma-client: Prisma 7의 새 생성기. 결과를 node_modules가 아니라 우리 폴더(output)에 만든다
// - src/generated/prisma는 생성물이라 커밋하지 않는다(.gitignore). npm install 때 postinstall로 다시 만든다
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// 데이터 원천: SQLite (파일 하나로 된 DB. 설치할 서버가 필요 없어 학습·개발에 좋다)
// 접속 주소(DATABASE_URL)는 prisma.config.ts와 lib/db.ts가 환경 변수에서 읽는다
// 배포(Step 11)에서는 서버가 파일을 저장할 수 없는 환경이 많아 Postgres로 바꾼다 — 이 provider와 주소만 바뀐다
datasource db {
  provider = "sqlite"
}

model Product {
  // @id: 기본 키(행마다 다른 고유 번호). @default(autoincrement()): 새 행마다 1씩 늘려 자동으로 붙인다
  id       Int    @id @default(autoincrement())
  name     String
  /// 가격(원). 돈은 소수 오차가 없게 정수로 저장한다
  price    Int
  category String
  /// 평점 0~5
  rating   Float  @default(0)
  /// 재고 수량. 0이면 품절
  stock    Int    @default(0)

  // 대표 이미지 — 화면 타입(ProductImage { src, width, height })을 열 세 개로 나눠 저장한다
  // ?: 비어 있어도 되는 열 (이미지가 없는 상품)
  imageSrc    String?
  imageWidth  Int?
  imageHeight Int?

  // 언제 만들고 고쳤는지 — 관리 화면(8-3)에서 쓴다. @updatedAt: 고칠 때마다 Prisma가 자동으로 지금 시각을 넣는다
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이 상품이 들어간 주문 상품들 (Step 9-3) — 관계 필드라 DB 열은 생기지 않는다
  orderItems OrderItem[]

  // 색인(index): 책의 찾아보기처럼, 카테고리로 거르는 조회를 빠르게 한다
  @@index([category])
}

// ─── 로그인 (Step 9-1, Better Auth) ─────────────────────────────────────
// Better Auth가 요구하는 테이블 4개. 필드 이름·종류는 Better Auth 1.7의 기본 스키마와 같아야 한다
// (node_modules/@better-auth/core/dist/db/get-tables.mjs). 우리가 읽고 쓰는 것은 주로 User이고,
// 나머지는 Better Auth가 알아서 쓴다.
// - id가 Int(자동 번호)가 아니라 String인 이유: Better Auth가 추측하기 어려운 무작위 문자열 id를 직접 만들어 넣는다.
//   번호(1, 2, 3...)면 다른 사용자의 id를 쉽게 짐작할 수 있다.
// - onDelete: Cascade — 사용자를 지우면 그 사용자의 세션·계정도 함께 지운다.

// 사용자 (회원 한 명)
model User {
  id            String    @id
  name          String
  email         String    @unique // 같은 이메일로 두 번 가입할 수 없다
  emailVerified Boolean   @default(false) // 이메일 인증 여부 (지금은 인증 메일을 보내지 않는다)
  /// 역할 (Step 9-2): 'user'(일반 회원) | 'admin'(관리자). 가입하면 항상 user — 관리자는 npm run auth:make-admin 으로만 바꾼다
  role          String    @default("user")
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[] // 이 사용자의 주문들 (Step 9-3)
}

// 로그인 세션 — "이 브라우저는 로그인되어 있다"는 기록. 쿠키에는 token만 들어가고, 누구인지는 이 표에서 찾는다
model Session {
  id        String   @id
  expiresAt DateTime // 이 시각이 지나면 로그아웃된 것으로 본다
  token     String   @unique // 브라우저 쿠키에 저장되는 값
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String? // 어떤 브라우저에서 로그인했는지
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 로그인 수단 — 이메일/비밀번호면 providerId가 'credential'이고 password에 '해시'가 저장된다(원래 비밀번호는 저장하지 않는다).
// 나중에 GitHub·Google 로그인을 더하면 같은 사용자에게 Account가 하나씩 늘어난다
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// 일회용 확인 값 (이메일 인증·비밀번호 재설정 링크 등). 지금은 쓰지 않지만 Better Auth가 테이블을 요구한다
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// ─── 주문 (Step 9-3) ─────────────────────────────────────────────────────

// 주문 한 건
model Order {
  id        Int         @id @default(autoincrement())
  userId    String
  // 사용자를 지우면 그 사용자의 주문도 지운다 (탈퇴 = 개인 정보 삭제). 실제 쇼핑몰은 법적 보관 기간 때문에 다르게 한다
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 총 금액(원) — 주문할 때 서버가 DB 가격으로 계산한 값. 화면이 보낸 금액은 믿지 않는다
  total     Int
  createdAt DateTime    @default(now())
  items     OrderItem[]

  // '내 주문 목록'은 사용자별·최신순으로 찾는다 → 그 순서대로 색인
  @@index([userId, createdAt])
}

// 주문에 담긴 상품 한 줄 — 주문 당시의 '사진'(스냅숏)
// 장바구니는 상품 id만 두고 이름·가격을 매번 상품 표에서 찾는다(항상 지금 가격, Step 5).
// 주문은 반대다: 주문한 뒤 가격이 바뀌거나 상품이 삭제돼도 '그때 얼마에 샀는지'는 그대로여야 한다(영수증).
// → 이름·가격·사진을 복사해 저장한다.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 원래 상품 (상품이 삭제되면 null — 주문 기록은 남는다)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 주문 당시 상품명
  name      String
  /// 주문 당시 단가(원)
  price     Int
  quantity  Int
  /// 주문 당시 대표 사진 주소 (목록에 작게 보여 줄 때)
  imageSrc  String?

  @@index([orderId])
  @@index([productId])
}
