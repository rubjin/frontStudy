# 환경 변수 예시 (cloude 브랜치 · AI 연동)
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 넣는다.  (.env.local 은 git에 올라가지 않는다)
#   cp .env.example .env.local
#
# 실제 키는 절대 이 파일(.env.example)이나 코드, 채팅에 적지 않는다.

# OpenRouter API 키 — https://openrouter.ai/settings/keys
# 키 하나로 Jev(typesafe/jev-1.13), Gemini, Qwen을 모두 부를 수 있다.
OPENROUTER_API_KEY=

# 1로 두면 키가 있어도 실제 API를 부르지 않고 가짜 응답(mock)으로 동작한다.
# 회사 PC처럼 외부 API가 막힌 곳, Storybook, 테스트에서 쓴다.
AI_MOCK=
